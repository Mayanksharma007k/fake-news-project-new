from mst_blockchain_sdk import Client
from app.config import settings


async def record_verification(verification_id: str, content_hash: str):
    if not settings.private_key:
        raise RuntimeError("PRIVATE_KEY is missing")

    try:
        client = Client("testnet", settings.private_key)

        address = client.signer.get_address()

        data = content_hash
        if not data.startswith("0x"):
            data = "0x" + data

        tx = {
            "from": address,
            "to": address,
            "value": 0,
            "data": data,
        }

        tx_hash = client.signer.send_transaction(tx)

        if hasattr(tx_hash, "hex"):
            tx_hash = tx_hash.hex()

        tx_hash = str(tx_hash)
        if not tx_hash.startswith("0x"):
            tx_hash = "0x" + tx_hash

        return {
            "network": "MST Testnet",
            "transaction_hash": tx_hash,
        }

    except Exception as exc:
        raise RuntimeError(
            f"MST Testnet transaction failed: {exc}"
        ) from exc
